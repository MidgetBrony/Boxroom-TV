<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Boxroom_TV</RootNamespace>
    <AssemblyName>Boxroom_TV</AssemblyName>
    <AssemblyVersion>3.3.0.0</AssemblyVersion>
    <FileVersion>3.3.0.0</FileVersion>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <VlcUnityRepo Condition="'$(VlcUnityRepo)' == ''">$(MSBuildProjectDirectory)\..\vlc-unity</VlcUnityRepo>
    <LibVLCSharpRepo Condition="'$(LibVLCSharpRepo)' == ''">$(MSBuildProjectDirectory)\..\LibVLCSharp</LibVLCSharpRepo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BR-MediaAPI\BR-MediaAPI.csproj" />
    <Reference Include="ModsPanel"><HintPath>..\ModsPanel\bin\Release\netstandard2.1\ModsPanel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LibVLCSharp"><HintPath>$(LibVLCSharpRepo)\src\LibVLCSharp\bin\Release\netstandard2.0\LibVLCSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VideoModule"><HintPath>$(GamePath)\BOXROOM_Data\Managed\UnityEngine.VideoModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(GamePath)\MelonLoader\net35\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\MelonLoader\net35\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateGamePath" BeforeTargets="ResolveReferences" Condition="!Exists('$(GamePath)\BOXROOM.exe')">
    <Error Text="GamePath must point to the BOXROOM installation. Copy Directory.Build.user.props.example to Directory.Build.user.props or pass -p:GamePath=..." />
  </Target>
  <Target Name="ValidateVlcBuild" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LibVLCSharpRepo)\src\LibVLCSharp\bin\Release\netstandard2.0\LibVLCSharp.dll')" Text="Build the LibVLCSharp master branch for netstandard2.0 with Unity=true first." />
    <Error Condition="'$(DeployToGame)' == 'true' And !Exists('$(VlcUnityRepo)\build_windows_local\PluginSource\libVLCUnityPlugin.dll')" Text="Build the VLC Unity Windows bridge first." />
  </Target>
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <VlcRuntimeFiles Include="$(VlcUnityRepo)\.build-tools\vlc\vlc-4.0.0-dev\plugins\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(GamePath)\Mods" />
    <MakeDir Directories="$(GamePath)\BOXROOM_Data\Plugins\x86_64\plugins" />
    <MakeDir Directories="$(GamePath)\UserData\Boxroom-TV\Licenses" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(LibVLCSharpRepo)\src\LibVLCSharp\bin\Release\netstandard2.0\LibVLCSharp.dll" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(VlcUnityRepo)\build_windows_local\PluginSource\libVLCUnityPlugin.dll" DestinationFiles="$(GamePath)\BOXROOM_Data\Plugins\x86_64\VLCUnityPlugin.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(VlcUnityRepo)\.build-tools\vlc\vlc-4.0.0-dev\libvlc.dll;$(VlcUnityRepo)\.build-tools\vlc\vlc-4.0.0-dev\libvlccore.dll" DestinationFolder="$(GamePath)\BOXROOM_Data\Plugins\x86_64" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VlcRuntimeFiles)" DestinationFiles="@(VlcRuntimeFiles->'$(GamePath)\BOXROOM_Data\Plugins\x86_64\plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="THIRD-PARTY-NOTICES.md;Licenses\LGPL-2.1.txt" DestinationFolder="$(GamePath)\UserData\Boxroom-TV\Licenses" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(GamePath)\UserData\Boxroom-TV\Tools" />
    <Copy SourceFiles="Tools\yt-dlp.exe" DestinationFolder="$(GamePath)\UserData\Boxroom-TV\Tools" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\BR-MediaAPI\bin\$(Configuration)\netstandard2.1\BR_MediaAPI.dll" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\BR-MediaAPI\Assets\brmediaapi_assets" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\ModsPanel\bin\Release\netstandard2.1\ModsPanel.dll" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
  </Target>
</Project>
